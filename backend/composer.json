{
  "name": "fullstack-todo-backend",
  "description": "Laravel 12 ToDo API scaffold",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^3.3",
    "ramsey/uuid": "^4.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  }
}